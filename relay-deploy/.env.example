# Public hostname whose DNS A/AAAA record points at this server.
# Caddy requests a certificate for it on first start.
RELAY_DOMAIN=relay.example.com

# Container memory limit, and the BEAM watermark at about 75% of it, in bytes.
#   2g -> 1610612736    4g -> 3221225472    8g -> 6442450944
RELAY_MEM_LIMIT=2g
RELAY_MEMORY_WATERMARK_BYTES=1610612736
